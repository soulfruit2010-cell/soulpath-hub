---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Life Path Calculator - SoulPath Hub"
  description="Calculate your life path number and discover your destiny.">

<div class="card">
  <h2>Life Path Calculator</h2>

  <form id="form">
    <input type="text" id="name" placeholder="Your Name" required />
    <input type="date" id="dob" required />

    <select id="gender">
      <option value="">Gender (optional)</option>
      <option value="male">Male</option>
      <option value="female">Female</option>
    </select>

    <button type="submit">Calculate</button>
  </form>
</div>

<script>
document.getElementById('form').addEventListener('submit', function(e) {
  e.preventDefault();

  const name = document.getElementById('name').value.toLowerCase().replace(/\s+/g,'-');
  const dob = document.getElementById('dob').value.replace(/-/g,'');

  window.location.href = `/life-path/${name}-${dob}`;
});
</script>

</BaseLayout>